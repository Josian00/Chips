---
import { useTranslations } from '../i18n/ui';
import type { LocalChip } from '../lib/chips';
import { formatDate } from '../lib/chips';
import { formatPrice, priceSummary } from '../lib/prices';

interface Props {
  chip: LocalChip;
}

const { chip } = Astro.props;
const { lang } = chip;
const t = useTranslations(lang);
const { stores, barcode } = chip.data;
const summary = priceSummary(chip);
const price = (amount: number, currency: string) => formatPrice(amount, currency, lang);
const regionName = new Intl.DisplayNames([lang], { type: 'region' });

// Sparkline of the tracked prices, oldest on the left.
const width = 200;
const height = 40;
let line = '';
if (summary && summary.points.length > 1) {
  const span = summary.high - summary.low || 1;
  const step = width / (summary.points.length - 1);
  line = summary.points
    .map((point, i) => `${(i * step).toFixed(1)},${(height - ((point.price - summary.low) / span) * (height - 4) - 2).toFixed(1)}`)
    .join(' ');
}
---

{
  (stores.length > 0 || barcode) && (
    <aside class="buy">
      <h2>{t('buy.title')}</h2>
      {stores.length > 0 && (
        <ul class="stores">
          {stores.map((store) => (
            <li>
              <span>
                <a
                  href={store.url}
                  target="_blank"
                  rel="noopener nofollow"
                  data-umami-event="Store link"
                  data-umami-event-store={store.name}
                  data-umami-event-chip={chip.id}
                >
                  {store.name}
                </a>
                {store.country && (
                  <abbr class="region" title={regionName.of(store.country)}>
                    {store.country}
                  </abbr>
                )}
              </span>
              {store.price !== undefined && (
                <span class="price">
                  {price(store.price, store.currency)}
                  {store.checked && <small>{t('buy.seen', { date: formatDate(store.checked, lang) })}</small>}
                </span>
              )}
            </li>
          ))}
        </ul>
      )}
      {summary ? (
        <div class="tracker">
          <h3>{t('buy.tracker')}</h3>
          <p class="latest">
            <strong>{price(summary.latest.price, summary.latest.currency)}</strong>
            {summary.latest.store && <> {t('buy.at')} {summary.latest.store}</>}
            {summary.latest.city && <>, {summary.latest.city}</>}
            <small>{t('buy.on', { date: formatDate(new Date(summary.latest.date), lang) })}</small>
          </p>
          {line && (
            <svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" role="img" aria-label={t('buy.history')}>
              <polyline points={line} />
            </svg>
          )}
          {summary.points.length > 1 && (
            <p class="range">
              {t('buy.range', {
                low: price(summary.low, summary.latest.currency),
                high: price(summary.high, summary.latest.currency),
                count: summary.points.length,
              })}
            </p>
          )}
          <p class="source">
            {t('buy.source.before')} <a href={`https://prices.openfoodfacts.org/products/${barcode}`} target="_blank" rel="noopener">Open Prices</a>{t('buy.source.after')}
          </p>
        </div>
      ) : (
        barcode && (
          <p class="source">
            {t('buy.none')} <a href={`https://prices.openfoodfacts.org/products/${barcode}`} target="_blank" rel="noopener">{t('buy.add')}</a>.
          </p>
        )
      )}
    </aside>
  )
}

<style>
  .buy {
    margin-top: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--card);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  h2 { margin: 0 0 0.75rem; font-size: 1.1rem; }
  h3 { margin: 1rem 0 0.4rem; font-size: 1rem; }
  .stores { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .stores li { display: flex; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
  .region {
    margin-left: 0.4rem;
    padding: 0 0.35rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    vertical-align: middle;
  }
  .price { text-align: right; }
  small { display: block; color: var(--muted); font-size: 0.8rem; }
  .latest { margin: 0; }
  svg { display: block; width: 100%; height: 2.5rem; margin: 0.5rem 0; overflow: visible; }
  polyline { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .range, .source { margin: 0.4rem 0 0; color: var(--muted); font-size: 0.85rem; }
</style>
