---
import type { Chip } from '../lib/chips';
import { excerpt, formatDate, postTitle } from '../lib/chips';
import { url } from '../lib/url';
import ChipPhoto from './ChipPhoto.astro';
import Rating from './Rating.astro';

interface Props {
  chip: Chip;
}

const { chip } = Astro.props;
const { country, rating, reviewed } = chip.data;
---

<article class="card">
  <a href={url(`chips/${chip.id}/`)}>
    <ChipPhoto chip={chip} />
    <div class="body">
      <p class="meta">
        <span>{country}</span>
        <Rating rating={rating} />
      </p>
      <h3>{postTitle(chip)}</h3>
      <p class="excerpt">{excerpt(chip)}</p>
      <time datetime={reviewed.toISOString()}>{formatDate(reviewed)}</time>
    </div>
  </a>
</article>

<style>
  .card a { display: block; color: inherit; text-decoration: none; }
  .card a:hover h3 { color: var(--accent-text); }
  .body { padding: 0.9rem 0.1rem 0; }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 0.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 { margin: 0 0 0.4rem; font-size: 1.35rem; line-height: 1.25; transition: color 0.15s; }
  .excerpt { margin: 0 0 0.5rem; color: var(--muted); }
  time { font-size: 0.85rem; color: var(--muted); }
</style>
