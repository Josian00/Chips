---
import { useTranslations } from '../i18n/ui';
import type { LocalChip } from '../lib/chips';
import Rating from './Rating.astro';

interface Props {
  chip: LocalChip;
}

const { lang, data } = Astro.props.chip;
const { brand, name, flavour, country, rating } = data;
const t = useTranslations(lang);
---

<aside class="facts">
  <h2>{t('facts.title')}</h2>
  <dl>
    <dt>{t('facts.chip')}</dt><dd>{name}</dd>
    <dt>{t('facts.brand')}</dt><dd>{brand}</dd>
    <dt>{t('facts.flavour')}</dt><dd>{flavour}</dd>
    <dt>{t('facts.country')}</dt><dd>{country}</dd>
    <dt>{t('facts.verdict')}</dt><dd><Rating rating={rating} lang={lang} /></dd>
  </dl>
</aside>

<style>
  .facts {
    padding: 1.25rem 1.5rem;
    background: var(--card);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  h2 { margin: 0 0 0.75rem; font-size: 1.1rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1.25rem; margin: 0; }
  dt { color: var(--muted); }
  dd { margin: 0; }
</style>
