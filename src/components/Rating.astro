---
import { defaultLang, locales, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  rating: number;
  lang?: Lang;
}

const { rating, lang = defaultLang } = Astro.props;
const shown = rating.toLocaleString(locales[lang]);
---

<span class="rating" title={useTranslations(lang)('rating.title', { rating: shown })}><strong>{shown}</strong>/10</span>

<style>
  .rating {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
