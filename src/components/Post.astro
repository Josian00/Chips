---
import { render } from 'astro:content';
import type { Chip } from '../lib/chips';
import { formatDate, postTitle, readingMinutes } from '../lib/chips';
import { url } from '../lib/url';
import ChipPhoto from './ChipPhoto.astro';
import FactBox from './FactBox.astro';
import Rating from './Rating.astro';
import WhereToBuy from './WhereToBuy.astro';

interface Props {
  chip: Chip;
  // On the home page the title links to the post's own page.
  linkTitle?: boolean;
  headingLevel?: 'h1' | 'h2';
}

const { chip, linkTitle = false, headingLevel: Heading = 'h1' } = Astro.props;
const { brand, country, rating, reviewed } = chip.data;
const { Content } = await render(chip);
const href = url(`chips/${chip.id}/`);
---

<article class="post">
  <header>
    <p class="kicker">{brand} · {country}</p>
    <Heading class="title">{linkTitle ? <a href={href}>{postTitle(chip)}</a> : postTitle(chip)}</Heading>
    <p class="byline">
      <time datetime={reviewed.toISOString()}>{formatDate(reviewed)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(chip)} min read</span>
      <Rating rating={rating} />
    </p>
  </header>
  <ChipPhoto chip={chip} size="hero" />
  <div class="columns">
    <div class="review"><Content /></div>
    <div class="sidebar">
      <FactBox chip={chip} />
      <WhereToBuy chip={chip} />
    </div>
  </div>
</article>

<style>
  header { max-width: 46rem; margin: 0 auto 1.5rem; text-align: center; }
  .kicker {
    margin: 0 0 0.5rem;
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .title { margin: 0 0 0.75rem; font-size: clamp(2rem, 5vw, 3.25rem); }
  .title a { color: inherit; text-decoration: none; }
  .title a:hover { color: var(--accent-text); }
  .byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .columns {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) 16rem;
    align-items: start;
    max-width: 56rem;
    margin: 2rem auto 0;
  }
  @media (max-width: 44rem) {
    .columns { grid-template-columns: 1fr; }
  }
  .review { font-size: 1.15rem; }
  .review :global(p:first-child) { margin-top: 0; }
  .review :global(p:first-child::first-letter) {
    float: left;
    margin: 0.1rem 0.5rem 0 0;
    font-family: var(--serif);
    font-size: 3.4rem;
    font-weight: 700;
    line-height: 0.9;
    color: var(--accent-text);
  }
</style>
