---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/nunito-sans/wght.css';
import Analytics from '../components/Analytics.astro';
import { languages, langs, locales, useTranslations, type Lang } from '../i18n/ui';
import { analyticsEnabled } from '../lib/analytics';
import { legalReady } from '../lib/legal';
import { splitPath, url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  // Languages this page exists in, for the language switch and hreflang
  // links. Defaults to all of them.
  available?: Lang[];
}

const { lang, path } = splitPath(Astro.url.pathname);
const t = useTranslations(lang);
const { title, description = t('site.description'), available = langs } = Astro.props;
const alternates = available.map((other) => ({ lang: other, href: new URL(url(path, other), Astro.site).href }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    <title>{title === 'Chips' ? `Chips · ${t('site.tagline')}` : `${title} · Chips`}</title>
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={url('', lang)}>
          <span class="logo" aria-hidden="true">🥔</span>
          <span>
            <span class="name">Chips</span>
            <span class="tagline">{t('site.tagline')}</span>
          </span>
        </a>
        <div class="menus">
          <nav>
            <a href={url('', lang)}>{t('nav.latest')}</a>
            <a href={url('chips/', lang)}>{t('nav.all')}</a>
            <a href={url('what-are-chips/', lang)}>{t('nav.what')}</a>
          </nav>
          <nav class="langs" aria-label={t('nav.language')}>
            {
              alternates.map((alt) =>
                alt.lang === lang ? (
                  <span aria-current="true" title={languages[alt.lang]}>{alt.lang.toUpperCase()}</span>
                ) : (
                  <a href={url(path, alt.lang)} hreflang={alt.lang} lang={alt.lang} title={languages[alt.lang]}>
                    {alt.lang.toUpperCase()}
                  </a>
                ),
              )
            }
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <p>{t('footer.motto')}</p>
        {
          analyticsEnabled && (
            <p class="privacy">
              {t('footer.analytics.before')} <a href="https://umami.is/privacy" target="_blank" rel="noopener">Umami</a>{t('footer.analytics.after')}
            </p>
          )
        }
        {
          legalReady && (
            <p class="legal">
              <a href={url('impressum/', lang)}>{t('footer.imprint')}</a>
              <span aria-hidden="true">·</span>
              <a href={url('datenschutz/', lang)}>{t('footer.privacy')}</a>
            </p>
          )
        }
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbf6ee;
    --fg: #2e2117;
    --muted: #7d6a57;
    --accent: #c4511d;
    --accent-text: #b2461a;
    --on-accent: #fff;
    --card: #fffdf9;
    --border: #e7d9c4;
    --green: #3b7432;
    --radius: 14px;
    --serif: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
    --sans: 'Nunito Sans Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1612;
      --fg: #f4ebe0;
      --muted: #b9a690;
      --accent: #e0703a;
      --accent-text: #f08a55;
      --on-accent: #1c1612;
      --card: #251d17;
      --border: #3d3127;
      --green: #8fc683;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--sans);
    font-size: 1.0625rem;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.65;
  }
  h1, h2, h3 { font-family: var(--serif); font-weight: 700; line-height: 1.2; }
  a { color: var(--accent-text); }
  .inner, main { max-width: 68rem; margin: 0 auto; padding: 0 1rem; }
  main { padding-top: 2rem; padding-bottom: 3rem; }

  .site-header { border-bottom: 1px solid var(--border); background: var(--card); }
  .site-header .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .brand { display: flex; align-items: center; gap: 0.75rem; color: inherit; text-decoration: none; }
  .logo { font-size: 2.25rem; }
  .brand .name { display: block; font-family: var(--serif); font-size: 1.75rem; font-weight: 700; line-height: 1; }
  .brand .tagline { display: block; color: var(--muted); font-size: 0.85rem; font-style: italic; }
  .menus { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; }
  nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  nav a {
    color: var(--fg);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  nav a:hover { color: var(--accent-text); }
  .langs {
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .langs a, .langs span { padding: 0.15rem 0.65rem; font-size: 0.8rem; }
  .langs span { background: var(--accent); color: var(--on-accent); }

  .site-footer { border-top: 1px solid var(--border); color: var(--muted); font-size: 0.9rem; text-align: center; }
  .site-footer .inner { padding-top: 1.5rem; padding-bottom: 2rem; }
  .site-footer .privacy { font-size: 0.8rem; }
  .site-footer .legal { display: flex; justify-content: center; gap: 0.5rem; font-size: 0.85rem; }

  .section-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0 1.25rem;
    font-size: 1.6rem;
  }
  .section-title::after { content: ''; flex: 1; border-top: 2px dotted var(--border); }
  .card-grid { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .muted { color: var(--muted); }
</style>
