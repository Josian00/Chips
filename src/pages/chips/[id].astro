---
import Base from '../../layouts/Base.astro';
import ChipCard from '../../components/ChipCard.astro';
import Comments from '../../components/Comments.astro';
import Post from '../../components/Post.astro';
import { excerpt, getChipsByDate, postTitle, suggestions, type Chip } from '../../lib/chips';

export async function getStaticPaths() {
  const chips = await getChipsByDate();
  return chips.map((chip) => ({ params: { id: chip.id }, props: { chip, related: suggestions(chips, chip) } }));
}

interface Props {
  chip: Chip;
  related: Chip[];
}

const { chip, related } = Astro.props;
---

<Base title={postTitle(chip)} description={excerpt(chip)}>
  <Post chip={chip} />
  {
    related.length > 0 && (
      <section>
        <h2 class="section-title">You might also like</h2>
        <div class="card-grid">{related.map((other) => <ChipCard chip={other} />)}</div>
      </section>
    )
  }
  <Comments term={`chips/${chip.id}`} />
</Base>
