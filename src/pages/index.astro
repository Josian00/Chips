---
import Base from '../layouts/Base.astro';
import ChipCard from '../components/ChipCard.astro';
import Post from '../components/Post.astro';
import { getChipsByDate, suggestions } from '../lib/chips';
import { url } from '../lib/url';

const chips = await getChipsByDate();
const [latest] = chips;
const more = suggestions(chips, latest, 6);
---

<Base title="Chips">
  {
    latest ? (
      <>
        <p class="eyebrow">Latest tasting</p>
        <Post chip={latest} linkTitle headingLevel="h2" />
      </>
    ) : (
      <p class="muted">No reviews yet. Add one in src/content/chips/.</p>
    )
  }

  {
    more.length > 0 && (
      <section>
        <h2 class="section-title">More to snack on</h2>
        <div class="card-grid">{more.map((chip) => <ChipCard chip={chip} />)}</div>
        <p class="all"><a href={url('chips/')}>Browse all {chips.length} reviews →</a></p>
      </section>
    )
  }
</Base>

<style>
  .eyebrow {
    margin: 0 0 1rem;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
  }
  .all { margin-top: 2rem; text-align: center; font-weight: 700; }
</style>
