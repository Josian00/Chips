---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ChipCard from '../components/ChipCard.astro';
import { url } from '../lib/url';

const chips = await getCollection('chips');
const topRated = [...chips].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);
const latest = [...chips]
  .sort((a, b) => b.data.reviewed.valueOf() - a.data.reviewed.valueOf())
  .slice(0, 3);
---

<Base title="Chips">
  <section class="hero">
    <h1>Chips &amp; crisps, reviewed.</h1>
    <p class="muted">
      A growing database of {chips.length} chips from around the world, each with a rating and an
      honest review.
    </p>
    <a href={url('chips/')}>Browse all chips →</a>
  </section>

  <h2>Top rated</h2>
  <div class="grid">{topRated.map((chip) => <ChipCard chip={chip} />)}</div>

  <h2>Latest reviews</h2>
  <div class="grid">{latest.map((chip) => <ChipCard chip={chip} />)}</div>
</Base>

<style>
  .hero { padding: 2rem 0 1rem; }
  .hero h1 { font-size: 2.5rem; margin: 0 0 0.5rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
</style>
